set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)

if(NOT DEFINED CMAKE_C_COMPILER)
    find_program(CMAKE_C_COMPILER clang)
    if(NOT CMAKE_C_COMPILER)
        find_program(CMAKE_C_COMPILER gcc)
    endif()
endif()

if(NOT DEFINED CMAKE_CXX_COMPILER)
    find_program(CMAKE_CXX_COMPILER clang++)
    if(NOT CMAKE_CXX_COMPILER)
        find_program(CMAKE_CXX_COMPILER g++)
    endif()
endif()

set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -arch arm64" CACHE STRING "C flags for Apple Silicon")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -arch arm64" CACHE STRING "CXX flags for Apple Silicon")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -arch arm64" CACHE STRING "Linker flags for Apple Silicon")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
