set(CMAKE_SYSTEM_NAME Emscripten)
set(CMAKE_SYSTEM_PROCESSOR wasm32)

if(NOT DEFINED CMAKE_C_COMPILER)
    find_program(CMAKE_C_COMPILER emcc)
    if(NOT CMAKE_C_COMPILER)
        message(FATAL_ERROR "emcc (Emscripten compiler) not found. Install Emscripten SDK from https://emscripten.org/")
    endif()
endif()

if(NOT DEFINED CMAKE_CXX_COMPILER)
    find_program(CMAKE_CXX_COMPILER em++)
    if(NOT CMAKE_CXX_COMPILER)
        find_program(CMAKE_CXX_COMPILER emcc)
    endif()
endif()

set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -s USE_SOCKETS=1 -s ALLOW_MEMORY_GROWTH=1 -s NO_EXIT_RUNTIME=1" CACHE STRING "C flags for WebAssembly")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -s USE_SOCKETS=1 -s ALLOW_MEMORY_GROWTH=1 -s NO_EXIT_RUNTIME=1" CACHE STRING "CXX flags for WebAssembly")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -s USE_SOCKETS=1 -s ALLOW_MEMORY_GROWTH=1 -s NO_EXIT_RUNTIME=1 -s EXPORTED_RUNTIME_METHODS=['ccallstr']" CACHE STRING "Linker flags for WebAssembly")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
