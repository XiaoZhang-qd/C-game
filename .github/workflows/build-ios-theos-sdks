name: 跨仓库自动编译iOS IPA
# 支持手动点击运行
on:
  workflow_dispatch:

env:
  # 改成你游戏仓库用户名+仓库名
  GAME_OWNER: XiaoZhang-qd
  GAME_REPO: C-game
  # 密钥从仓库Secrets读取，不要明文写token
  GH_TOKEN: ${{ secrets.GH_TOKEN }}

jobs:
  build_ios:
    runs-on: ubuntu-latest
    steps:
      # 1 拉取游戏完整源码（自动clean拉最新）
      - name: 拉取游戏仓库代码
        run: |
          rm -rf game-src
          git clone https://${GH_TOKEN}@github.com/${GAME_OWNER}/${GAME_REPO}.git game-src
          cd game-src
          echo "源码拉取完成"

      # 2 安装系统依赖
      - name: 安装编译依赖
        run: |
          sudo apt update
          sudo apt install -y git build-essential fakeroot perl curl unzip libtinfo5 zip

      # 3 完整部署Theos工具链+iOS SDK
      - name: 部署Theos交叉编译环境
        run: |
          rm -rf ~/theos
          git clone --recursive https://github.com/theos/theos.git ~/theos
          cd ~/theos/sdks
          git pull
          echo "export THEOS=$HOME/theos" >> ~/.bashrc
          echo "export PATH=\$THEOS/bin:\$PATH" >> ~/.bashrc
          source ~/.bashrc
          bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)"
          echo "Theos工具链安装完毕"

      # 4 覆盖修复版编译脚本
      - name: 写入修复build-ios-theos.sh
        working-directory: ./game-src
        run: |
          cat > ./build-ios-theos.sh << 'SCRIPT_EOF'
#!/usr/bin/env bash
set -e
echo "========================================"
echo "  CGame Racer iOS Build (Theos SDKs)"
echo "========================================"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export THEOS="$HOME/theos"
export PATH="$THEOS/toolchain/linux/iphone/bin:$THEOS/bin:$PATH"
cd "${SCRIPT_DIR}"

IOS_ARCH="${1:-arm64}"
IOS_MIN_VER="${2:-16.5}"
BUNDLE_ID="${3:-com.cgame.racer}"
BUNDLE_NAME="${4:-CGame Racer}"

THEOS_SDKS="${THEOS}/sdks"
if [ ! -d "${THEOS_SDKS}" ]; then
    echo "[ERROR] Theos SDK缺失！"
    exit 1
fi

SDK_NAME="iPhoneOS${IOS_MIN_VER}.sdk"
SDK_PATH="${THEOS_SDKS}/${SDK_NAME}"
if [ ! -d "${SDK_PATH}" ]; then
    AVAILABLE_SDKS=$(ls -d ${THEOS_SDKS}/iPhoneOS*.sdk 2>/dev/null | sort -V)
    SDK_PATH=$(echo "${AVAILABLE_SDKS}" | tail -1)
    SDK_NAME=$(basename "${SDK_PATH}")
    echo "[WARN] 未找到指定SDK，自动使用最新：${SDK_NAME}"
fi
echo "[INFO] 当前SDK: ${SDK_NAME}"

SDKVER="${SDK_NAME#iPhoneOS}"
SDKVER="${SDKVER%%.*}"
IOS_VERSION="${SDK_NAME#iPhoneOS}"

# Linux专用iOS交叉clang
CROSS_CLANG="${THEOS}/toolchain/linux/iphone/bin/clang"
CROSS_CXX="${THEOS}/toolchain/linux/iphone/bin/clang++"
if [ -x "${CROSS_CLANG}" ]; then
    CC="${CROSS_CLANG}"
    CXX="${CROSS_CXX}"
    echo "[INFO] 交叉编译器: ${CC}"
else
    echo "[ERROR] iOS编译工具链缺失，终止！"
    exit 1
fi

# SDK头文件、库路径
SDK_INCLUDE="${SDK_PATH}/usr/include"
SDK_LIB="${SDK_PATH}/usr/lib"
FRAMEWORKS="${SDK_PATH}/System/Library/Frameworks"
CLANG_SDK_LIB="${SDK_PATH}/usr/lib/clang/${SDKVER}/lib"

BUILD_DIR="${SCRIPT_DIR}/build-ios-theos"
rm -rf "${BUILD_DIR}"
mkdir -p "${BUILD_DIR}"
cd "${BUILD_DIR}"

# 游戏源码列表
SOURCES=(
    "../common/socket.c"
    "../server/main.c"
    "../server/server.c"
    "../client/main.c"
    "../client/gui.c"
    "../client/game.c"
    "../client/network.c"
    "../client/raygui_impl.c"
)

INCLUDES=(
    "-I${SCRIPT_DIR}/common"
    "-I${SCRIPT_DIR}/client"
    "-I${SCRIPT_DIR}/server"
    "-I${SCRIPT_DIR}/raylib/src"
    "-I${SCRIPT_DIR}/raygui-5.0/src"
    "-I${SDK_INCLUDE}"
    "-I${SDK_INCLUDE}/c++"
    "-I${SDK_INCLUDE}/c++/backward"
    "-I${SDK_INCLUDE}/c++/v1"
)

TARGET_TRIPLE="arm64-apple-ios${SDKVER}"
# 删除Windows/macOS专属 -arch 参数
COMMON_FLAGS=(
    "-isysroot ${SDK_PATH}"
    "-target ${TARGET_TRIPLE}"
    "-miphoneos-version-min=${IOS_VERSION}"
    "-fembed-bitcode"
    "-O2"
    "-DNDEBUG"
    "-DCGAME_IOS=1"
)

# 批量编译C源码
for src in "${SOURCES[@]}"; do
    BASENAME=$(basename "${src}" .c)
    echo "编译: ${BASENAME}.c"
    ${CC} "${COMMON_FLAGS[@]}" "${INCLUDES[@]}" -c "${src}" -o "${BASENAME}.o"
done

# 编译raylib
if [ -f "${SCRIPT_DIR}/raylib/src/libraylib.a" ]; then
    RAYLIB_LIB="${SCRIPT_DIR}/raylib/src/libraylib.a"
else
    cd "${SCRIPT_DIR}/raylib"
    make -j4 PLATFORM=PLATFORM_IOS CC="${CC}" AR="ar" CFLAGS="${COMMON_FLAGS[*]} ${INCLUDES[*]}"
    cd "${BUILD_DIR}"
    RAYLIB_LIB="${SCRIPT_DIR}/raylib/src/libraylib.a"
fi

# 链接客户端可执行文件
CLIENT_FILES=$(ls *.o | grep -v "^server_" || true)
LINK_CMD="${CC} ${COMMON_FLAGS[*]} ${CLIENT_FILES} ${RAYLIB_LIB} -L${SDK_LIB} -L${CLANG_SDK_LIB} -F${FRAMEWORKS} -framework Foundation -framework UIKit -framework CoreGraphics -framework CoreMotion -framework OpenGLES -framework QuartzCore -lpthread -lm -o c-game-client"
eval ${LINK_CMD}

# 构建App包结构
APP_DIR="Payload/CGame Racer.app"
rm -rf Payload
mkdir -p "${APP_DIR}"
cp c-game-client "${APP_DIR}/CGame Racer"
chmod +x "${APP_DIR}/CGame Racer"

# 写入Info.plist
cat > "${APP_DIR}/Info.plist" << PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleDisplayName</string><string>${BUNDLE_NAME}</string>
<key>CFBundleExecutable</key><string>CGame Racer</string>
<key>CFBundleIdentifier</key><string>${BUNDLE_ID}</string>
<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
<key>CFBundleName</key><string>${BUNDLE_NAME}</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>1.0.0</string>
<key>CFBundleVersion</key><string>1.0</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
<key>UILaunchScreen</key><dict/>
<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
<key>UISupportedInterfaceOrientations</key>
<array>
<string>UIInterfaceOrientationPortrait</string>
<string>UIInterfaceOrientationLandscapeLeft</string>
<string>UIInterfaceOrientationLandscapeRight</string>
</array>
</dict>
</plist>
PLIST_EOF
echo "APPL????" > "${APP_DIR}/PkgInfo"

# 打包IPA
IPA_NAME="c-game-client-arm64-ios${SDKVER}.ipa"
zip -r "${IPA_NAME}" Payload
echo "OUTPUT_IPA=${IPA_NAME}" >> $GITHUB_ENV
echo "编译打包完成！输出文件：${IPA_NAME}"
SCRIPT_EOF
          chmod +x ./build-ios-theos.sh

      # 5 执行编译打包
      - name: 执行iOS编译
        working-directory: ./game-src
        run: |
          source ~/.bashrc
          bash ./build-ios-theos.sh arm64 16.5

      # 6 自动在【游戏仓库】创建Release，上传IPA下载包
      - name: 发布到游戏仓库Release页面
        working-directory: ./game-src
        uses: softprops/action-gh-release@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GH_TOKEN }}
          # 指定目标仓库（游戏仓库）
          GITHUB_REPOSITORY: ${{ env.GAME_OWNER }}/${{ env.GAME_REPO }}
        with:
          tag_name: ios-build-${{ github.run_id }}
          name: iOS自动构建包 #${{ github.run_number }}
          body: >
            云端Theos Linux交叉编译生成iOS IPA
            使用说明：
            1. 越狱iPhone：dpkg解压安装
            2. 普通iPhone：TrollStore / AltStore 侧载安装
            3. 无苹果开发者签名，无法直接上架AppStore
          files: build-ios-theos/*.ipa
          prerelease: true
          make_latest: false
